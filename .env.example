# Host directories mounted by Docker Compose. Analysis publishes its atomic
# output beneath RESULTS_DIR/published; SQLite is stored beneath STATE_DIR.
UPLOAD_DIR=./upload
RESULTS_DIR=./data/results
STATE_DIR=./data/state

# Ports exposed on the host for local development.
FRONTEND_PORT=8080
BACKEND_PORT=8000

# Spark master used only by the on-demand analysis child process.
SPARK_MASTER=local[*]

# The idle worker checks the persistent job queue at this interval. Spark is
# started only after a queued job is claimed.
JOB_POLL_SECONDS=1

# Local-only shared value used by Nginx to protect the analysis POST endpoint.
# Replace it in .env if the stack is reachable by other machines.
ANALYSIS_API_TOKEN=local-development-only

# Cloud-only backend settings. Keep JOB_BACKEND=local for Docker Compose.
# The Elastic Beanstalk environment overrides these values; AWS credentials
# come from its IAM instance profile and must never be written here.
JOB_BACKEND=local
AWS_REGION=ap-southeast-2
# AWS_JOB_TABLE=cs5224-lab2-jobs
# AWS_ECS_CLUSTER=cs5224-lab2-analysis
# AWS_ECS_TASK_DEFINITION=arn:aws:ecs:ap-southeast-2:123456789012:task-definition/cs5224-lab2-analysis:1
# AWS_ECS_CONTAINER_NAME=analysis
# AWS_ECS_SUBNET_ID=subnet-0123456789abcdef0
# AWS_ECS_SECURITY_GROUP_ID=sg-0123456789abcdef0
# DATA_BUCKET=cs5224-lab2-data-example
# RESULT_POINTER_KEY=results/latest.json
# ORIGIN_VERIFY_SECRET=set-by-terraform-in-elastic-beanstalk

